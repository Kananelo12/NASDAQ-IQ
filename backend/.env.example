# Copy to .env and fill in. Never commit .env.

PORT=3000

# Neon connection string (Neon dashboard > Connect). Keep ?sslmode=verify-full.
DATABASE_URL=postgresql://user:password@ep-xxxx.us-east-2.aws.neon.tech/neondb?sslmode=verify-full

# Comma-separated browser origins allowed to call the API.
CORS_ORIGIN=http://localhost:5173

# Min 16 chars. Sent as the x-jobs-secret header to POST /api/jobs/:name/run.
JOBS_SECRET=change-me-to-a-long-random-string

# true on Render Starter (always on). false if GitHub Actions triggers jobs instead.
ENABLE_INTERNAL_CRON=true

# GitHub Actions fallback (.github/workflows/scheduled-jobs.yml). If the API moves to a
# free Render plan that sleeps, in-process cron stops running reliably, so GitHub Actions
# triggers jobs over HTTP instead. To switch: comment out the line above, uncomment the
# line below, and set USE_GH_SCHEDULER=true in the GitHub repo variables.
# ENABLE_INTERNAL_CRON=false

# Free key from https://aistudio.google.com/apikey. The API boots without it.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
